NODE_ENV=production
RESTART=always
COMPOSE_FILE=docker-compose.v2.prod.yml
DOCKER_DOMAIN=katago-api.localhost
PROJECT=katago-api
DOCKER_DB_PORT=18070

DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_CHARSET=utf8

STORAGE_URL=https://storage.katago-api.localhost

API_TOKEN=change-me

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated chat ids allowed to run bot commands (/ping, /sendReport). /start is public.
TELEGRAM_ADMIN_IDS=

# Max JSON body size (batch of 1000 SGFs needs more than Express default ~100kb)
BODY_LIMIT=50mb

KATAGO_BIN=/opt/katago/katago
KATAGO_CONFIG=/home/node/app/katago/analysis.cfg
KATAGO_MODEL=/home/node/app/katago/models/default.bin.gz
#KATAGO_MODEL_URL=https://github.com/lightvector/KataGo/releases/download/v1.4.5/g170e-b20c256x2-s5303129600-d1228401921.bin.gz
#KATAGO_MODEL_URL=https://media.katagotraining.org/uploaded/networks/models/kata1/kata1-zhizi-b40c768nbt-s11272M-d5935M.bin.gz
KATAGO_MODEL_URL=https://media.katagotraining.org/uploaded/networks/models/kata1/kata1-b18c384nbt-s9996604416-d4316597426.bin.gz
KATAGO_QUERY_TIMEOUT_MS=1800000
# Stop KataGo after this many ms with no pending queries (0 = keep process forever).
# TensorRT first init can take minutes; keep idle a bit longer so engines aren't rebuilt often.
KATAGO_IDLE_STOP_MS=60000
# First TensorRT plan/timing-cache build may need several minutes.
KATAGO_READY_TIMEOUT_MS=600000
